# Required: use the same long random token in the service and tfcbot environments.
NONAME_PARSER_TOKEN=
NONAME_PARSER_HOST=127.0.0.1
NONAME_PARSER_PORT=3210
NONAME_PARSER_DATA_DIR=/var/lib/noname-parser
# tfcbot's local service; public uploads still go to Hampalyzer and TFCStats.
NONAME_PARSER_URL=http://127.0.0.1:3210
NONAME_PARSER_MATCH_URL=https://nonamepickup.servehalflife.com/match.html?id={matchId}
# Set only when importing outside the standard bot installation.
DB_PATH=/root/tfcbot/elo.db
