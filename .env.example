# Optional HLTV registry. Append these to your existing bot .env.
HLTV_REGISTRY_ENABLED=false
HLTV_STORAGE_ROOT=/srv/noname-hltv
HLTV_REGISTRY_DB=/srv/noname-hltv/registry.db
# Set to the actual Nginx document root to reject unsafe storage configurations.
HLTV_PUBLIC_ROOT=/var/www/nonamepickup-web
HLTV_MAX_DEMO_BYTES=268435456
HLTV_MIN_DISK_FREE_BYTES=10737418240
# Optional guard: wait for the remote demo directory BEFORE the existing download.
HLTV_FINALIZATION_CHECK_ENABLED=false
HLTV_FINALIZATION_WAIT_MS=120000
HLTV_ALERTS_ENABLED=false
# NEW dedicated private channel, never falls back to the ordinary ADMIN channel.
HLTV_REVIEW_ALERT_CHANNEL_ID=
# Comma-separated Discord user IDs; role IDs do not grant review access.
HLTV_REVIEW_ALLOWED_USER_IDS=
HLTV_REVIEW_BASE_URL=https://nonamepickup.servehalflife.com
